"npm Registry": {
    "descriptionUrl": "doc/npm_registry.md",
    "c2Projects": [
        "https://github.com/7856ebonee/npm-c2"
    ],
    "detection": [
        "GET - url: https://registry.npmjs.org/-/package/*/dist-tags",
        "PUT - url: https://registry.npmjs.org/-/package/*/dist-tags/*",
        "url: https://registry.npmjs.org/-/package/*/dist-tags",
        "detection strategy: Non-Node.js process making periodic HTTPS requests to registry.npmjs.org",
        "detection strategy: dist-tag names containing base64url-encoded data (cmm_*, res_*, hbt_* prefix pattern)",
        "detection strategy: npm token appearing in non-Node.js binary strings or process memory",
        "detection strategy: Periodic polling with statistical jitter to a single npm package dist-tags endpoint",
        "User-Agent: Python-urllib/*",
        "User-Agent: Go-http-client/*",
        "User-Agent: python-requests/*"
    ]
}
